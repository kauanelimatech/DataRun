# Supabase: Project Connect > App Frameworks > Next.js
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-side only. Get this from Supabase: Project Settings > API > Secret key.
# Never expose this value with a NEXT_PUBLIC_ prefix or commit it to Git.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Instagram API with Instagram Login. Keep every value server-side and out of Git.
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
# Generate with: openssl rand -base64 32
INSTAGRAM_TOKEN_ENCRYPTION_KEY=base64_32_byte_key
